{
  "manifest_version": 3,
  "name": "Anti-XSS Shield",
  "version": "3.0",
  "description": "Продвинутая защита от XSS и кражи Cookies с мониторингом сети",
  "action": {
    "default_popup": "popup.html"
  },
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "cookies"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "ruleset_1",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["bridge.js"]
    },
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "world": "MAIN"
    }
  ]
}